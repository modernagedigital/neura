        "$description": "From 56 to 80"
      },
      "4xl-6xl": {
        "$type": "dimension",
        "$value": "(({spacing.fluid.6xl} - {spacing.fluid.4xl}) * {spacing.fluid.location}) + {spacing.fluid.4xl}",
        "$description": "From 64 to 88"
