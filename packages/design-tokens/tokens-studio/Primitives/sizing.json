      },
      "lg-2xl": {
        "$type": "dimension",
        "$value": "(({spacing.fluid.2xl} - {spacing.fluid.lg}) * {spacing.fluid.location}) + {spacing.fluid.lg}",
        "$description": "From 32 to 56"
      },
      "xl-3xl": {
        "$type": "dimension",
        "$value": "(({spacing.fluid.3xl} - {spacing.fluid.xl}) * {spacing.fluid.location}) + {spacing.fluid.xl}",
        "$description": "From 40 to 64"
